<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/app_name"
        android:scaleX="1"
        android:scaleY="1"
        android:src="@mipmap/ic_cat_notes_round" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/menu"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textSize="@dimen/dialog_title_size" />

    <TextView
        android:id="@+id/textViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/menu"
        android:text="@string/about_version"
        android:textSize="@dimen/dialog_message_size" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/menu"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/about_description"
        android:textSize="@dimen/dialog_message_size" />

    <TextView
        android:id="@+id/textViewContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/menu"
        android:text="@string/about_contact_developer"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/dialog_message_size" />


    <Button
        android:id="@+id/dialog_positive"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:fontFamily="@font/menu"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/ok"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorLink"
        android:textSize="@dimen/dialog_button_text_size" />

</LinearLayout>