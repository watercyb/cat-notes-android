<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".editor.Editor"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/linearLayoutTopbar"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/imageButtonBack"
            android:layout_width="45dp"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:contentDescription="@string/back"
            android:paddingTop="3dp"
            android:paddingBottom="5dp"
            android:scaleType="center"
            app:srcCompat="@mipmap/back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/imageButtonPassword"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="25dp"
            android:background="@null"
            android:contentDescription="@string/password"
            android:visibility="gone"
            app:srcCompat="@mipmap/password" />

        <ImageButton
            android:id="@+id/imageButtonClone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="25dp"
            android:background="@null"
            android:contentDescription="@string/clone"
            android:visibility="gone"
            app:srcCompat="@mipmap/clone" />

        <ImageButton
            android:id="@+id/imageButtonRemove"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="10dp"
            android:background="@null"
            android:contentDescription="@string/remove"
            android:scaleType="center"
            app:srcCompat="@mipmap/remove" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:translationZ="1dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/frameLayoutBottom"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/imageButtonUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/circle_button_background"
            android:importantForAccessibility="no"
            android:paddingStart="1dp"
            android:paddingEnd="2dp"
            android:scaleType="fitCenter"
            app:srcCompat="@mipmap/ic_undo" />

        <ImageButton
            android:id="@+id/imageButtonRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_button_background"
            android:importantForAccessibility="no"
            android:paddingStart="2dp"
            android:paddingEnd="1dp"
            android:scaleType="fitCenter"
            android:scaleX="1"
            android:scaleY="1"
            app:srcCompat="@mipmap/ic_redo" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayoutTitle"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutTopbar">

    </FrameLayout>

    <EditText
        android:id="@+id/editTextTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:fontFamily="@font/text"
        android:hint="@string/title"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:tag="24"
        android:text=""
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutTitle"
        tools:ignore="LabelFor" />

    <FrameLayout
        android:id="@+id/frameLayoutNote"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextTitle">

    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        app:layout_constraintBottom_toTopOf="@id/frameLayoutBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutNote"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editTextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:fontFamily="@font/text"
                android:gravity="top"
                android:hint="@string/Note"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scrollbars="vertical"
                android:tag="18"
                android:text=""
                android:textSize="18sp"
                tools:ignore="LabelFor" />

            <View
                android:id="@+id/viewContentPadding"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="45dp" />

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/frameLayoutBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>