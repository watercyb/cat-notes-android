<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".editor.Editor">

    <ImageButton
        android:id="@+id/imageButtonBack"
        android:layout_width="45dp"
        android:layout_height="35dp"
        android:layout_marginStart="10dp"
        android:background="@null"
        android:contentDescription="@string/back"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/back" />

    <ImageButton
        android:id="@+id/imageButtonPassword"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="25dp"
        android:background="@null"
        android:contentDescription="@string/password"
        android:scaleX="1"
        android:scaleY="1"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/imageButtonClone"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/password" />

    <ImageButton
        android:id="@+id/imageButtonClone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="25dp"
        android:background="@null"
        android:contentDescription="@string/clone"
        android:scaleX="1"
        android:scaleY="1"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/imageButtonRemove"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/clone" />

    <ImageButton
        android:id="@+id/imageButtonRemove"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="10dp"
        android:background="@null"
        android:contentDescription="@string/remove"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/remove" />

    <FrameLayout
        android:id="@+id/frameLayoutTitle"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageButtonBack">

    </FrameLayout>

    <EditText
        android:id="@+id/editTextTitle"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@color/background"
        android:hint="@string/title"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text=""
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutTitle"
        tools:ignore="LabelFor" />

    <FrameLayout
        android:id="@+id/frameLayoutNote"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextTitle">

    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        app:layout_constraintBottom_toTopOf="@id/frameLayoutBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutNote"
        app:layout_constraintVertical_bias="1.0">

        <EditText
            android:id="@+id/editTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:gravity="top"
            android:hint="@string/Note"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:scrollbars="vertical"
            android:text=""
            tools:ignore="LabelFor" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/frameLayoutBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>